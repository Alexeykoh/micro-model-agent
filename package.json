{
  "name": "micro-models-agent",
  "version": "2.25.0",
  "description": "Micro Models Agent (MMA) — LLM agent harness for small models (Qwen3.5-9B, 32K-64K context)",
  "type": "module",
  "bin": {
    "mma": "bin/mma.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mma": "bun run src/cli/main.ts",
    "build": "bun run build:tsc && bun run build:copy-assets",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:copy-assets": "bun run scripts/copy-assets.ts",
    "build:frontend": "bun run scripts/build-frontend.ts",
    "build:optimize": "bun run scripts/optimize-dist.ts",
    "build:prod": "bun run 'build:clean' && bun run 'build:bundle' && bun run 'build:frontend' && bun run 'build:copy-assets' && bun run 'build:optimize'",
    "build:clean": "bun run scripts/clean.ts",
    "build:bundle": "bun build ./src/cli/main.ts --outfile ./dist/main.js --target node --format esm --packages external",
    "dev": "bun --watch src/cli/main.ts",
    "web:dev": "bun --watch src/cli/main.ts web --no-open",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc -p tsconfig.frontend.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "quality": "bun run typecheck && bun run typecheck:frontend && bun run lint && bun run fallow",
    "fallow": "fallow dead-code --baseline .fallow-baseline.json --fail-on-issues",
    "fallow:baseline": "fallow dead-code --save-baseline .fallow-baseline.json",
    "fallow:security": "fallow security",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "format": "prettier --write \"src/**/*.{ts,js,mjs,json}\" \"tests/**/*.{ts,js,json}\" \"scripts/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,mjs,json}\" \"tests/**/*.{ts,js,json}\" \"scripts/**/*.ts\" \"*.{ts,json}\""
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-tiktoken": "^1.0.0",
    "jsonrepair": "^3.15.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.62.0",
    "string-width": "^8.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
