{
  "name": "mma",
  "version": "0.1.0",
  "description": "Micro Models Agent (MMA) — LLM agent harness for small models",
  "type": "module",
  "bin": {
    "mma": "./src/index.ts"
  },
  "scripts": {
    "mma": "bun run src/index.ts",
    "build": "bunx tsc",
    "dev": "bun --watch src/index.ts",
    "test": "bun test tests/context.test.ts tests/sanitizer.test.ts tests/code-index.test.ts tests/plan-todo-memory.test.ts tests/file-loader-syntax.test.ts",
    "test:integration": "bun test tests/llm-integration.test.ts tests/agent-integration.test.ts",
    "test:all": "bun test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-tiktoken": "^1.0.0",
    "jsonrepair": "^3.15.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
