{
  "name": "micro-models-agent",
  "version": "0.3.0",
  "description": "Micro Models Agent (MMA) — LLM agent harness for small models (Qwen3.5-9B, 32K-64K context)",
  "type": "module",
  "bin": {
    "mma": "dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mma": "bun run src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun --watch src/cli/main.ts",
    "test": "bun test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-tiktoken": "^1.0.0",
    "jsonrepair": "^3.15.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
