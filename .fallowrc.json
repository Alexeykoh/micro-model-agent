{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/cli/main.ts",
    "bin/mma.mjs",
    "scripts/*.ts",
    "src/modules/browser/bridge-server.mjs"
  ],
  "ignorePatterns": [
    "examples/plugins/**",
    "dist/**",
    "certification/**",
    "_testing/**",
    "src/modules/webui/assets/**",
    "gh-pages/**"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "audit": {
    "gate": "new-only",
    "deadCodeBaseline": ".fallow-baseline.json",
    "healthBaseline": ".fallow-health-baseline.json",
    "dupesBaseline": ".fallow-dupes-baseline.json"
  }
}
