# MMA Agent Service — production image (deployment/ops, P1).
# Build: docker build -f deploy/Dockerfile.service -t mma-service:0.25.0 .
# Run:   docker run --rm -p 8080:8080 -e MMA_SERVICE_TOKEN="$SECRET" mma-service:0.25.0
# The sandbox Dockerfile in repo root is for execution.profile=sandbox (bash only);
# this image runs `mma serve` as a long-lived service.
FROM oven/bun:1.3.14

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts || bun install --ignore-scripts
COPY . .
RUN bun run build 2>/dev/null || true

ENV MMA_SERVICE_HOST=0.0.0.0 \
    MMA_SERVICE_PORT=8080 \
    NODE_ENV=production
EXPOSE 8080
USER 1000:1000

# Liveness/readiness use the standard names (/healthz, /readyz);
# /v1/health and /v1/ready remain as aliases.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD bun -e "const r=await fetch('http://127.0.0.1:8080/healthz');process.exit(r.ok?0:1)"

CMD ["bun", "run", "src/index.ts", "serve", "--host", "0.0.0.0", "--port", "8080"]
