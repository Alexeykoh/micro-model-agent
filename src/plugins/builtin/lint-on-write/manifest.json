{
    "version":  "1.0.0",
    "name":  "lint-on-write",
    "events":  [
                   "tool:after"
               ],
    "description":  "Auto-run linter after write_file/edit_file — informs model of lint errors",
    "config":  {
                   "lintCommand":  null,
                   "cacheFile":  ".lint-detected"
               },
    "entry":  "index.js"
}